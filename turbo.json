{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET",
        "AUTH0_DOMAIN",
        "AUTH0_SECRET",
        "DOCS_ADMIN_PASSPHRASE",
        "SUPABASE_SERVICE_ROLE_KEY",
        "NODE_ENV",
        "PAYSTACK_SECRET_KEY",
        "RESEND_API_KEY",
        "TRADING_VERCEL_TOKEN",
        "TRADING_VERCEL_PROJECT_ID",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "WORKOS_COOKIE_PASSWORD",
        "NEXT_PUBLIC_APP_URL",
        "BETA_GROUP_EMAIL",
        "GOOGLE_SA_EMAIL",
        "GOOGLE_SA_PRIVATE_KEY",
        "GOOGLE_ADMIN_SUBJECT",
        "BETA_PLAY_OPT_IN_URL",
        "GOOGLE_PLAY_PRO_SKU",
        "CRON_SECRET",
        "DARAJA_ENV",
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_OPENAI_API_KEY",
        "AZURE_OPENAI_API_VERSION",
        "AZURE_OPENAI_CHAT_DEPLOYMENT",
        "AZURE_OPENAI_EMBEDDING_DEPLOYMENT",
        "AZURE_VISION_ENDPOINT",
        "AZURE_VISION_API_KEY",
        "ANTHROPIC_API_KEY",
        "PARTNER_AUTH_SECRET",
        "PREVIEW_SECRET",
        "GOOGLE_PLAY_HOBBY_SKU",
        "REVIEW_ACCOUNT_EMAIL",
        "REVIEW_ACCOUNT_PASSWORD",
        "HANDOFF_ENC_KEY",
        "R2_WORKER_URL",
        "R2_AUTH_SECRET",
        "PALPLUSS_API_KEY",
        "PALPLUSS_API_TOKEN",
        "UPCLOUD_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}