{%- assign heading = section.heading | default: 'What We Offer' -%}
{%- assign eyebrow = section.eyebrow | default: 'Services' -%}
{%- assign limit = section.limit | default: 3 -%}
{%- if services and services.size > 0 -%}
<section class="py-12 md:py-20">
  <div class="container mx-auto max-w-6xl px-6">
    {{- - HEADER - -}}
    <div class="mb-10 md:mb-14">
      <div class="flex items-center gap-4 mb-3">
        <div class="h-px flex-1" style="background-color: var(--sf-border)"></div>
        <span class="sf-badge-outline inline-flex items-center border px-2.5 py-0.5 text-xs font-medium" {% render 'classic/snippets/editable', editing: store.editing, field: 'eyebrow', value: section.eyebrow %}>
          {{ eyebrow }}
        </span>
        <div class="h-px flex-1" style="background-color: var(--sf-border)"></div>
      </div>
      <h2 class="sf-heading text-3xl md:text-4xl font-light text-center tracking-tight" {% render 'classic/snippets/editable', editing: store.editing, field: 'heading', value: section.heading %}>{{ heading }}</h2>
    </div>

    {{- - GRID - -}}
    <div class="grid gap-6 md:gap-8" style="grid-template-columns: repeat(auto-fill, minmax(400px, 1fr))">
      {%- for service in services -%}
        {%- if forloop.index > limit -%}{%- break -%}{%- endif -%}

        {%- assign image = '' -%}
        {%- assign video = '' -%}
        {%- for m in service.media -%}
          {%- if m.type == 'image' and image == '' -%}{%- assign image = m.url -%}{%- endif -%}
          {%- if m.type == 'video' and video == '' -%}{%- assign video = m.url -%}{%- endif -%}
        {%- endfor -%}

        {%- assign desc = service.description | strip_html -%}
        {%- assign is_long = false -%}
        {%- if desc and desc.size > 160 -%}{%- assign is_long = true -%}{%- endif -%}

        <article class="sf-card sf-service-card overflow-hidden flex flex-col">
          {{- - IMAGE - -}}
          <div class="relative overflow-hidden sf-bg-muted" style="aspect-ratio: 3/2">
            {%- if image and image != '' -%}
              <img src="{{ image | escape }}" alt="{{ service.name | escape }}" loading="lazy" class="w-full h-full object-cover">
            {%- endif -%}
          </div>

          
            {%- if video and video != '' -%}
              <a
                href="{{ video | escape }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex text-center items-center gap-2 px-4 py-1.5 text-xs font-medium mt-1 w-full bg-primary"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  {% raw %}<path d="M8 5v14l11-7z"/>{% endraw %}
                </svg>
                Watch video
              </a>
            {%- endif -%}

          {{- - CONTENT - -}}
          <div class="px-5 pt-4 pb-5 flex-1 flex flex-col gap-2">
            <h3 class="sf-heading text-lg font-medium leading-tight">{{ service.name }}</h3>

            {%- if desc and desc != '' -%}
  <div class="sf-service-desc">
    <p class="sf-service-desc__text text-sm" style="color: var(--sf-foreground-subtle)">{{ desc }}</p>
    {%- if is_long -%}
      <details class="sf-service-desc__details">
        <summary class="sf-service-desc__toggle text-xs font-medium">
          <span class="sf-service-desc__label-closed">Learn more</span>
          <span class="sf-service-desc__label-open">Show less</span>
        </summary>
      </details>
    {%- endif -%}
  </div>
{%- endif -%}

    <div class="flex-1 flex-row flex gap-2 justify-between" style="color: var(--sf-foreground); border-top: 1px solid var(--sf-border)">
            {%- if service.price -%}
              <div class="mt-auto pt-3 text-base font-light">
                {{ service.price | money: store.currency }}
              </div>
            {%- endif -%}
            {{- - VIEW MORE - -}}
      <div class="mt-3">
        <a
          href="/store/{{ store.slug }}/services/{{service.slug}}"
          class="sf-pill sf-pill-inactive border px-8 py-2.5 text-sm inline-flex items-center gap-2 transition-all"
        >
          Get Started
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {% raw %}<path d="M5 12h14M12 5l7 7-7 7"/>{% endraw %}
          </svg>
        </a>
      </div>
      </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- endif -%}